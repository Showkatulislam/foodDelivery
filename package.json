{
    "name": "food-delivery-eda",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "directories": {
        "doc": "docs"
    },
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "postinstall": "prisma skills sync || exit 0",
        "prepare": "husky",
        "db:migrate": "npx prisma migrate dev",
        "db:studio": "npx prisma studio"
    },
    "lint-staged": {
        "*.{ts,tsx,js,mjs,cjs}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Showkatulislam/foodDelivery.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "bugs": {
        "url": "https://github.com/Showkatulislam/foodDelivery/issues"
    },
    "homepage": "https://github.com/Showkatulislam/foodDelivery#readme",
    "dependencies": {
        "@prisma/adapter-pg": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "dotenv": "^18.0.10",
        "express": "^5.3.0",
        "ioredis": "^6.0.0",
        "pg": "^8.23.1",
        "pino": "^10.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.6",
        "@types/pg": "^8.23.1",
        "eslint": "10.15.0",
        "globals": "17.14.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.2",
        "pino-pretty": "^13.2.0",
        "prettier": "^3.10.1",
        "prisma": "^7.10.1",
        "tsx": "^4.23.15",
        "typescript": "6.0.3",
        "typescript-eslint": "8.73.0"
    }
}
